#!/usr/bin/env python3
"""LifeOS World Map: the OpenStreetMap map of the explorable world.

Shows where you are in the LifeOS apartment's world, searches places, and teleports you anywhere on Earth (click the
map, then "Teleport here"), or back home to the apartment. It runs a small web page on this computer only
(127.0.0.1) and opens it in the browser; teleports are handed to the apartment through
~/.local/state/lifeos/teleport. Map data and tiles (c) OpenStreetMap contributors; searches use Nominatim, at most
one request a second, as its usage policy asks.
"""
import http.server
import json
import os
import shutil
import socketserver
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request

STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "lifeos")
UA = "LifeOS-WorldMap/1.0 (https://github.com/SoulVoid0/ai-lifeos)"
last_ping = time.time()
last_search = 0.0
search_lock = threading.Lock()

PAGE = r"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>LifeOS World Map</title>
<style>
:root{--bg:#0f1420;--panel:#171e2e;--txt:#e8ecf4;--dim:#9aa4b8;--acc:#78beff;--warn:#ffd27a}
html,body{margin:0;height:100%;background:var(--bg);color:var(--txt);font:15px system-ui,sans-serif}
#bar{position:absolute;z-index:1000;left:12px;right:12px;top:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
#bar>*{background:var(--panel);color:var(--txt);border:1px solid #2a3550;border-radius:10px;padding:9px 12px;font:inherit}
#q{flex:1;min-width:200px}
button{cursor:pointer}button:hover{border-color:var(--acc)}
#home{background:#24406b}
#map{position:absolute;inset:0}
#status{position:absolute;z-index:1000;left:12px;bottom:28px;background:var(--panel);border:1px solid #2a3550;border-radius:10px;padding:8px 12px;max-width:70%}
#results{position:absolute;z-index:1001;left:12px;top:62px;background:var(--panel);border:1px solid #2a3550;border-radius:10px;max-width:520px;display:none}
#results div{padding:8px 12px;cursor:pointer;border-bottom:1px solid #222b40}#results div:hover{background:#22304a}
.places{display:flex;gap:6px;flex-wrap:wrap}.places button{padding:6px 9px;font-size:13px}
.tp{background:var(--acc);color:#08111f;border:0;border-radius:8px;padding:7px 10px;font-weight:600}
</style></head><body>
<div id="map"></div>
<div id="bar">
  <input id="q" placeholder="Search a place (city, street, landmark) or type lat, lon and press Enter">
  <button id="home" title="Teleport back to the apartment">Teleport home</button>
  <button id="me">Where am I</button>
  <button id="go">Back to the apartment</button>
</div>
<div id="results"></div>
<div id="status">Loading...</div>
<script>
// The map (Leaflet + OpenStreetMap tiles) needs internet; everything else here works without it.
let map = null, me = null;
let first = true, pos = null;
const st = document.getElementById('status');
function initMap() {
  map = L.map('map', {worldCopyJump: true}).setView([30, 10], 3);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'}).addTo(map);
  me = L.circleMarker([0, 0], {radius: 9, color: '#08111f', weight: 3, fillColor: '#78beff', fillOpacity: 1});
  map.on('click', e => popupAt(e.latlng));
  first = true; refresh();
}
const CDNS = ['https://unpkg.com/leaflet@1.9.4/dist/', 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/'];
function loadLeaflet(i) {
  if (i >= CDNS.length) { st.dataset.touched = '1'; st.innerHTML = 'The map needs internet. You can still teleport home, or type coordinates (lat, lon) in the box above.'; return; }
  const lc = document.createElement('link');
  lc.rel = 'stylesheet'; lc.href = CDNS[i] + 'leaflet.css';
  document.head.appendChild(lc);
  const lf = document.createElement('script');
  lf.src = CDNS[i] + 'leaflet.js';
  lf.onload = initMap;
  lf.onerror = () => { lc.remove(); loadLeaflet(i + 1); };
  document.head.appendChild(lf);
}
loadLeaflet(0);
setTimeout(() => { if (!map && !st.dataset.touched) { st.dataset.touched = '1'; st.textContent = 'Still loading the map (it needs internet). Teleport home and lat, lon in the box work without it.'; } }, 12000);
function show(lat, lon, label) {
  if (map) { const ll = L.latLng(lat, lon); map.setView(ll, 17); popupAt(ll, label); }
  else teleport(lat, lon, label);
}
async function post(path, body) {
  const r = await fetch(path, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body || {})});
  return r.json();
}
async function teleport(lat, lon, label) {
  const r = await post('/teleport', {lat, lon});
  st.innerHTML = r.ok ? `Teleporting to <b>${label || (lat.toFixed(5) + ', ' + lon.toFixed(5))}</b>. Go back to the apartment to be there (button above, or Shift+F4).`
                      : 'Teleport failed: ' + (r.error || '?');
  if (map) map.closePopup();
}
function popupAt(latlng, label) {
  const div = document.createElement('div');
  div.innerHTML = `<div style="margin-bottom:6px">${label ? '<b>' + label + '</b><br>' : ''}${latlng.lat.toFixed(5)}, ${latlng.lng.toFixed(5)}</div>`;
  const b = document.createElement('button');
  b.className = 'tp'; b.textContent = 'Teleport here';
  b.onclick = () => teleport(latlng.lat, ((latlng.lng + 540) % 360) - 180, label);
  div.appendChild(b);
  L.popup().setLatLng(latlng).setContent(div).openOn(map);
}
document.getElementById('home').onclick = async () => {
  const r = await post('/teleport', {home: true});
  st.textContent = r.ok ? 'Teleporting home. Go back to the apartment (button above, or Shift+F4).' : 'Failed: ' + r.error;
};
document.getElementById('go').onclick = async () => { await post('/go'); st.textContent = 'Opening the apartment...'; };
document.getElementById('me').onclick = () => { if (pos && pos.outside && Math.abs(pos.lat) < 85 && map) map.setView([pos.lat, pos.lon], 17); else if (pos && pos.outside && Math.abs(pos.lat) < 85) st.textContent = `You are at ${pos.lat.toFixed(5)}, ${pos.lon.toFixed(5)}.`; else st.textContent = pos && pos.outside ? 'You are near the South Pole (the map can’t show the poles).' : 'You are home in the apartment, at the South Pole.'; };
const q = document.getElementById('q'), res = document.getElementById('results');
q.addEventListener('keydown', async e => {
  if (e.key !== 'Enter' || !q.value.trim()) return;
  const m = q.value.trim().match(/^(-?\d+(?:\.\d+)?)\s*[, ]\s*(-?\d+(?:\.\d+)?)$/);
  if (m) { const la = +m[1], lo = +m[2]; if (Math.abs(la) <= 90 && Math.abs(lo) <= 180) { res.style.display = 'none'; show(la, lo); } else st.textContent = 'That is not on Earth (lat -90..90, lon -180..180)'; return; }
  st.textContent = 'Searching...';
  const r = await (await fetch('/search?q=' + encodeURIComponent(q.value.trim()))).json();
  res.innerHTML = '';
  if (!r.length) { st.textContent = 'Nothing found (searching needs internet)'; res.style.display = 'none'; return; }
  st.textContent = r.length + ' found';
  for (const p of r) {
    const d = document.createElement('div');
    d.textContent = p.display_name;
    d.onclick = () => { res.style.display = 'none'; show(+p.lat, +p.lon, p.display_name.split(',')[0]); };
    res.appendChild(d);
  }
  res.style.display = 'block';
});
const PLACES = [['Times Square', 40.75800, -73.98550], ['Eiffel Tower', 48.85837, 2.29448], ['Shibuya Crossing', 35.65952, 139.70056],
  ['Big Ben', 51.50072, -0.12462], ['Sydney Opera House', -33.85678, 151.21530], ['Colosseum', 41.89021, 12.49223],
  ['Gamla stan', 59.32531, 18.07109], ['Golden Gate Bridge', 37.80853, -122.47569], ['Burj Khalifa', 25.19720, 55.27437]];
const pl = document.createElement('div'); pl.className = 'places';
for (const [n, la, lo] of PLACES) { const b = document.createElement('button'); b.textContent = n; b.onclick = () => show(la, lo, n); pl.appendChild(b); }
document.getElementById('bar').appendChild(pl);
async function refresh() {
  try {
    pos = await (await fetch('/pos')).json();
    if (map && pos.outside && Math.abs(pos.lat) < 85) {
      me.setLatLng([pos.lat, pos.lon]).addTo(map);
      if (first) { map.setView([pos.lat, pos.lon], 16); first = false; }
    }
    if (first && map) first = false;
    if (!st.dataset.touched) st.innerHTML = !pos.world_on ? 'Explorable world is off: teleporting turns it on.'
      : pos.outside ? `You are ${pos.underground ? 'underground ' : ''}at ${pos.place ? '<b>' + pos.place + '</b>, ' : ''}${pos.lat.toFixed(5)}, ${pos.lon.toFixed(5)}. Click the map to teleport.`
      : 'You are home in the apartment (South Pole). Click the map anywhere to teleport.';
  } catch (e) {}
}
st.addEventListener('click', () => st.dataset.touched = '');
setInterval(refresh, 3000); refresh();
setInterval(() => fetch('/ping', {method: 'POST'}), 5000);
</script></body></html>
"""


class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, code, body, ctype="application/json"):
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        global last_ping, last_search
        last_ping = time.time()
        u = urllib.parse.urlparse(self.path)
        if u.path == "/":
            return self.send(200, PAGE, "text/html; charset=utf-8")
        if u.path == "/pos":
            try:
                with open(os.path.join(STATE, "world-pos.json")) as f:
                    return self.send(200, f.read())
            except OSError:
                return self.send(200, json.dumps({"lat": -89.9975, "lon": 0, "outside": False, "world_on": False, "place": ""}))
        if u.path == "/search":
            q = urllib.parse.parse_qs(u.query).get("q", [""])[0][:200]
            if not q:
                return self.send(200, "[]")
            with search_lock:
                wait = 1.1 - (time.time() - last_search)
                if wait > 0:
                    time.sleep(wait)
                last_search = time.time()
                try:
                    url = "https://nominatim.openstreetmap.org/search?" + urllib.parse.urlencode({"format": "json", "limit": 8, "q": q})
                    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept-Language": "en"})
                    with urllib.request.urlopen(req, timeout=20) as r:
                        return self.send(200, r.read())
                except Exception:
                    return self.send(200, "[]")
        self.send(404, "{}")

    def do_POST(self):
        global last_ping
        last_ping = time.time()
        n = int(self.headers.get("Content-Length") or 0)
        try:
            body = json.loads(self.rfile.read(n) or b"{}") if n else {}
        except ValueError:
            body = {}
        if self.path == "/ping":
            return self.send(200, "{}")
        if self.path == "/teleport":
            os.makedirs(STATE, exist_ok=True)
            try:
                if body.get("home"):
                    text = "home\n"
                else:
                    lat, lon = float(body["lat"]), float(body["lon"])
                    if not (-90 <= lat <= 90 and -180 <= lon <= 180):
                        raise ValueError("outside the Earth")
                    text = f"{lat:.7f} {lon:.7f}\n"
                tmp = os.path.join(STATE, "teleport.tmp")
                with open(tmp, "w") as f:
                    f.write(text)
                os.replace(tmp, os.path.join(STATE, "teleport"))
                return self.send(200, json.dumps({"ok": True}))
            except (KeyError, ValueError, OSError) as e:
                return self.send(200, json.dumps({"ok": False, "error": str(e)}))
        if self.path == "/go":
            exe = shutil.which("lifeos-apartment")
            if exe:
                subprocess.Popen([exe], start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return self.send(200, json.dumps({"ok": bool(exe)}))
        self.send(404, "{}")


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True


def main():
    srv = Server(("127.0.0.1", 0), H)
    url = f"http://127.0.0.1:{srv.server_address[1]}/"
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    browser = shutil.which("firefox")
    if browser:
        subprocess.Popen([browser, "--new-window", url], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.Popen(["xdg-open", url], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(url, flush=True)
    # ends a while after the page is closed
    while time.time() - last_ping < 120:
        time.sleep(5)
    srv.shutdown()


if __name__ == "__main__":
    sys.exit(main())
