#!/bin/bash
# Steam on the living room TV: opens Big Picture (Steam's TV mode). The first time, installs Steam in a terminal:
# Arch's 32-bit [multilib] repository and the 32-bit graphics driver for this computer's GPU.
if ! command -v steam >/dev/null; then
  if [ "$1" != "--in-terminal" ]; then
    exec konsole --hide-menubar --hide-tabbar -e /usr/bin/lifeos-steam --in-terminal
  fi
  echo "Setting up Steam"
  echo "================"
  echo "Steam isn't installed yet. Installing it needs your password and about 1 GB of downloads."
  [ -d /run/archiso ] && echo "(Live USB: Steam stays until the computer restarts. Install LifeOS to keep it.)"
  echo
  if ! sudo /usr/lib/lifeos/lifeos-steam-setup; then
    echo; read -rp "Steam wasn't installed. Press Enter to close." _; exit 1
  fi
  echo; echo "Steam is installed. Starting Big Picture (the first start downloads Steam's own files)..."
  setsid -f steam -gamepadui >/dev/null 2>&1 < /dev/null
  sleep 4
  exit 0
fi
if pgrep -u "$USER" -f 'ubuntu12_32/steam' >/dev/null || pgrep -u "$USER" -x steam >/dev/null; then
  exec steam steam://open/bigpicture
fi
exec steam -gamepadui
