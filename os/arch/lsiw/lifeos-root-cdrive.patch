@@ -37,7 +37,7 @@
 #include <time.h>
 #include <unistd.h>
 
-#define DEFAULT_CDRIVE "${HOME}/.cdrive"
+#define DEFAULT_CDRIVE "/"   /* LifeOS: C: is the root of the file system */
 #define OLD_DEFAULT_CDRIVE "${HOME}/c_drive"   /* the default until 1.7.0 */
 #define DEFAULT_SHARED "${DATA}/shared"
 
@@ -341,6 +341,7 @@ static void drop_own_links(const char *root)
 int lsiw_cdrive_migrate(int verbose)
 {
     if (lsiw_cdrive_setting()) return 0;          /* a location the user chose */
+    if (!strcmp(lsiw_root_dir(), "/")) return 0;  /* LifeOS: C: is the file system root */
     char *old = folder_value(OLD_DEFAULT_CDRIVE);
     char *to = folder_value(DEFAULT_CDRIVE);
     struct stat st;
@@ -375,6 +376,14 @@ int lsiw_cdrive_move(const char *path, int folders, int verbose)
         return -1;
     }
     lsiw_cdrive_migrate(verbose);
+    if (!strcmp(lsiw_root_dir(), "/")) {
+        /* LifeOS: C: is the whole Linux file system. Moving it would move the operating system, so only
+         * an administrator can point C: elsewhere, by editing /etc/lsiw/lsiw.conf. */
+        lsiw_log("C: is the root of the file system (/) on this system and cannot be moved; "
+                 "an administrator can change [drive] c_drive in /etc/lsiw/lsiw.conf\n");
+        free(to);
+        return -1;
+    }
     char *from = strdup(lsiw_root_dir());
     char *real_from = realpath(from, NULL);
     size_t fl = strlen(from), tl = strlen(to);
