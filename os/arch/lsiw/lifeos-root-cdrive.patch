diff --git a/src/common/paths.c b/src/common/paths.c
index 4c7824f..9d95113 100644
--- a/src/common/paths.c
+++ b/src/common/paths.c
@@ -306,12 +306,17 @@ int lsiw_sync_root(int verbose)
         if (!t[i].anchor) continue;
         const char *loc = lsiw_var_linux(t[i].name);
         if (!loc) continue;
-        char *link = lsiw_strdup_printf("%s/%s", root, t[i].anchor);
+        char *link = lsiw_strdup_printf("%s/%s", strcmp(root, "/") ? root : "", t[i].anchor);
         if (strcmp(link, loc)) ensure_symlink(link, loc, verbose);
         else lsiw_mkdirs(loc, 0755);
         free(link);
     }
 
+    /* LifeOS: the C: drive can be the Linux root itself ([drive] c_drive = /). Then every top-level
+     * folder already is C:\<name>: there is nothing to link (and linking "/bin" onto itself would
+     * replace the real /bin link), and nothing of LSIW's own to clean up. */
+    if (!strcmp(root, "/")) goto profiles;
+
     /* One entry per top-level Linux directory. */
     DIR *d = opendir("/");
     if (d) {
@@ -352,6 +357,7 @@ int lsiw_sync_root(int verbose)
         closedir(d);
     }
 
+profiles:;
     /* Inside the profiles folder, the standard names must lead to the
      * configured profile locations (C:\users\<me>, Public, Default). */
     const char *profiles = lsiw_var_linux("PROFILESFOLDER");
@@ -369,7 +375,7 @@ int lsiw_sync_root(int verbose)
         /* Proton runs every program as "steamuser"; in LSIW's own users
          * folder that is you as well, so games under Proton and programs
          * under Wine share one profile. */
-        size_t rl = strlen(root);
+        size_t rl = strcmp(root, "/") ? strlen(root) : 0;
         const char *me = lsiw_var_linux("CSIDL_PROFILE");
         if (me && !strncmp(profiles, root, rl) && profiles[rl] == '/' && strcmp(lsiw_user_name(), "steamuser")) {
             char *su = lsiw_strdup_printf("%s/steamuser", profiles);
diff --git a/src/common/prefix.c b/src/common/prefix.c
