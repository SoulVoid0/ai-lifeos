#!/bin/sh
# Installs Wine, LSIW's fallback for windowed, 32-bit and installer programs. Wine lives in Arch's multilib
# repository, which this turns on first.
set -e
if ! grep -q '^\[multilib\]' /etc/pacman.conf; then
  printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' | sudo tee -a /etc/pacman.conf >/dev/null
fi
sudo pacman -Sy --needed --noconfirm wine wine-mono wine-gecko winetricks
echo "Wine is installed. LSIW uses it for programs its own engine can't run yet."
