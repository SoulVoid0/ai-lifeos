{
  "audio_config": {
    "audio": "pipewire"
  },
  "bootloader": "Systemd-boot",
  "kernels": [
    "linux"
  ],
  "network_config": {
    "type": "nm"
  },
  "ntp": true,
  "profile_config": {
    "profile": {
      "main": "Minimal"
    }
  },
  "packages": [
    "lifeos",
    "lsiw",
    "base-devel",
    "nano",
    "flatpak",
    "linux-firmware",
    "amd-ucode",
    "intel-ucode"
  ],
  "services": [
    "sddm",
    "NetworkManager",
    "bluetooth",
    "ollama",
    "lifeos-firstuser"
  ],
  "swap": true,
  "custom_commands": [
    "sed -i '/^\\[lifeos\\]/,+2d' /etc/pacman.conf"
  ]
}
